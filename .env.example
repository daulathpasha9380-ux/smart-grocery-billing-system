# FreshLedger Environment Variables Template
# Copy values into your shell or deployment environment; Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=prod

# Render Web Service port (Render injects PORT dynamically; defaults to 8080)
PORT=8080

# Production PostgreSQL / Neon Settings (active when SPRING_PROFILES_ACTIVE=prod)
# Use JDBC URL with ?sslmode=require for Neon PostgreSQL
DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-with-a-unique-database-password

# Initial owner bootstrap credentials (required on first production startup when app_users table has 0 owners)
# Minimum 12 characters, maximum 72 UTF-8 bytes. Never disclose or hardcode.
APP_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-initial-owner-password
APP_BOOTSTRAP_OWNER_EMAIL=owner@example.com

# Persistent storage directory for uploaded product images (use /app/data/product-images in Docker)
APP_PRODUCT_IMAGES_DIRECTORY=/app/data/product-images

# Email delivery for password reset (optional)
APP_PUBLIC_BASE_URL=https://your-service-name.onrender.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Development passwords for built-in accounts (only active when SPRING_PROFILES_ACTIVE=dev)
APP_AUTH_OWNER_PASSWORD=replace-with-a-unique-owner-password
APP_AUTH_CASHIER_PASSWORD=replace-with-a-unique-cashier-password
APP_AUTH_CUSTOMER_PASSWORD=replace-with-a-unique-customer-password
APP_AUTH_OWNER_EMAIL=owner@example.com
APP_AUTH_CASHIER_EMAIL=cashier@example.com

# Only for a one-time H2-to-PostgreSQL migration; point at a verified backup.
H2_MIGRATION_URL=jdbc:h2:file:C:/path/to/backup/billing-backup;IFEXISTS=TRUE;ACCESS_MODE_DATA=R
H2_MIGRATION_USERNAME=sa
H2_MIGRATION_PASSWORD=
APP_MIGRATION_H2_TO_POSTGRES_ENABLED=false
